            <SetVelocity x="0.0" y="0.0" theta="0.0" />
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" /> 
            <SubTree ID="Locate" _autoremap="true" />
        <ReactiveSequence/>
      </ReactiveSequence>

      <!-- 4. Corner_Kick -->
      <ReactiveSequence _while="gc_game_sub_state_type=='CORNER_KICK'" name="Corner_Kick">
        <ReactiveSequence _while="gc_game_sub_state=='STOP'">
