<root BTCPP_format="4">
  <include path="./cam_find_and_track_ball.xml" />
  <include path="./locate.xml" />
  <include path="./find_ball.xml" />
  <include path="./auto_getup_and_locate.xml" />
  <include path="./subtrees/goalkeeper.xml" />

  <BehaviorTree ID="Goalkeeper">
    <ReactiveSequence>
      <!-- 자기 위치 추정 -->
      <SelfLocate mode="trust_direction" />
      <SubTree ID="Locate" _autoremap="true"/>

      <!-- 1. Direct_Free_Kick -->
      <ReactiveSequence _while="gc_game_sub_state_type=='DIRECT_FREE_KICK'" name="Direct_Free_Kick">
        <ReactiveSequence _while="gc_game_sub_state=='STOP'">
            <SetVelocity x="0.0" y="0.0" theta="0.0" /> 
            <SubTree ID="Locate" _autoremap="true" />
        <ReactiveSequence/>
        
        <ReactiveSequence _while="gc_game_sub_state=='GET_READY'">
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <GolieInitPos vx_limit="0.3" vy_limit="0.15"/>
            <SubTree ID="Locate" _autoremap="true" />
        <ReactiveSequence/>

        <ReactiveSequence _while="gc_game_sub_state=='SET'">
            <SetVelocity x="0.0" y="0.0" theta="0.0" />
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" /> 
            <SubTree ID="Locate" _autoremap="true" />
        <ReactiveSequence/>
      </ReactiveSequence>

      <!-- 2. Indirect_Free_Kick -->
      <ReactiveSequence _while="gc_game_sub_state_type=='INDIRECT_FREE_KICK'" name="Indirect_Free_Kick">
