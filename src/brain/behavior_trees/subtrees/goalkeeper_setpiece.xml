        <ReactiveSequence/>
      </ReactiveSequence>

      <!-- 7. Free_Kick (default) -->
      <ReactiveSequence _while="gc_game_sub_state_type=='FREE_KICK'" name="Throw_In (default)">
        <ReactiveSequence _while="gc_game_sub_state=='STOP'">
            <SetVelocity x="0.0" y="0.0" theta="0.0" />
